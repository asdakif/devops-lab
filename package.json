{
  "name": "devops-task-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/store.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:backup": "node --test test/operations/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "@prometheus-io/client": "^0.16.1"
  },
  "devDependencies": { "supertest": "^7.1.4" }
}
