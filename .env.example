# npm run setup generates random credentials in .env. Do not commit .env.
POSTGRES_USER=devops
POSTGRES_DB=devops
POSTGRES_PASSWORD=replace-with-random-password
API_TOKEN=replace-with-random-token
API_PORT=3080
PROMETHEUS_PORT=9095
# For local Node development: start Compose db with compose.dev.yaml.
DATABASE_URL=postgresql://devops:replace-with-random-password@127.0.0.1:5435/devops
PORT=3080
